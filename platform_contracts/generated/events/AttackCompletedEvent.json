{
  "$defs": {
    "EventType": {
      "enum": [
        "program_created",
        "workflow_requested",
        "workflow_started",
        "stage_queued",
        "stage_started",
        "artifact_published",
        "gate_passed",
        "gate_failed",
        "eval_completed",
        "attack_completed",
        "decision_issued",
        "lesson_promoted",
        "approval_required",
        "approval_resolved",
        "workflow_finished",
        "stage_cancelled"
      ],
      "title": "EventType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A red-team / adversarial campaign finished. Carries ASR plus anti-forgetting signals.",
  "properties": {
    "campaign_id": {
      "title": "Campaign Id",
      "type": "string"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "$ref": "#/$defs/EventType",
      "default": "attack_completed"
    },
    "forgetting_rate": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Forgetting Rate"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "report_ref": {
      "title": "Report Ref",
      "type": "string"
    },
    "retention_rate": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retention Rate"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "stage_run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stage Run Id"
    },
    "success_rate": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Success Rate",
      "type": "number"
    },
    "successful_attempts": {
      "minimum": 0,
      "title": "Successful Attempts",
      "type": "integer"
    },
    "target_model_id": {
      "title": "Target Model Id",
      "type": "string"
    },
    "total_attempts": {
      "minimum": 0,
      "title": "Total Attempts",
      "type": "integer"
    },
    "vulnerability_patterns": {
      "items": {
        "type": "string"
      },
      "title": "Vulnerability Patterns",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "campaign_id",
    "target_model_id",
    "success_rate",
    "total_attempts",
    "successful_attempts",
    "report_ref"
  ],
  "title": "AttackCompletedEvent",
  "type": "object"
}