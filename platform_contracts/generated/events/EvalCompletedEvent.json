{
  "$defs": {
    "EventType": {
      "enum": [
        "program_created",
        "workflow_requested",
        "workflow_started",
        "stage_queued",
        "stage_started",
        "artifact_published",
        "gate_passed",
        "gate_failed",
        "eval_completed",
        "attack_completed",
        "decision_issued",
        "lesson_promoted",
        "approval_required",
        "approval_resolved",
        "workflow_finished",
        "stage_cancelled",
        "audit_completed",
        "audit_followup",
        "improvement_applied",
        "agent_step",
        "debug_result"
      ],
      "title": "EventType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A benchmark / eval suite finished for a run. Carries the measured metrics.",
  "properties": {
    "eval_suite_id": {
      "title": "Eval Suite Id",
      "type": "string"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "$ref": "#/$defs/EventType",
      "default": "eval_completed"
    },
    "gate_passed": {
      "default": true,
      "title": "Gate Passed",
      "type": "boolean"
    },
    "metrics": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Metrics",
      "type": "object"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "passed": {
      "title": "Passed",
      "type": "boolean"
    },
    "report_ref": {
      "title": "Report Ref",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "stage_run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stage Run Id"
    }
  },
  "required": [
    "run_id",
    "eval_suite_id",
    "passed",
    "report_ref"
  ],
  "title": "EvalCompletedEvent",
  "type": "object"
}