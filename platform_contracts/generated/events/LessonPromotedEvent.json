{
  "$defs": {
    "EventType": {
      "enum": [
        "program_created",
        "workflow_requested",
        "workflow_started",
        "stage_queued",
        "stage_started",
        "artifact_published",
        "gate_passed",
        "gate_failed",
        "eval_completed",
        "attack_completed",
        "decision_issued",
        "lesson_promoted",
        "approval_required",
        "approval_resolved",
        "workflow_finished",
        "stage_cancelled"
      ],
      "title": "EventType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A LessonCard was promoted from a transient observation into a platform object.",
  "properties": {
    "applicable_stages": {
      "items": {
        "type": "string"
      },
      "title": "Applicable Stages",
      "type": "array"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "$ref": "#/$defs/EventType",
      "default": "lesson_promoted"
    },
    "lesson_id": {
      "title": "Lesson Id",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "pattern_type": {
      "title": "Pattern Type",
      "type": "string"
    },
    "payload_ref": {
      "title": "Payload Ref",
      "type": "string"
    },
    "prm_score": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Prm Score",
      "type": "number"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "scope": {
      "title": "Scope",
      "type": "string"
    },
    "source_run_id": {
      "title": "Source Run Id",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "lesson_id",
    "source_run_id",
    "scope",
    "pattern_type",
    "prm_score",
    "confidence",
    "payload_ref"
  ],
  "title": "LessonPromotedEvent",
  "type": "object"
}