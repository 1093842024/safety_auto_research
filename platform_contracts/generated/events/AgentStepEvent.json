{
  "$defs": {
    "EventType": {
      "enum": [
        "program_created",
        "workflow_requested",
        "workflow_started",
        "stage_queued",
        "stage_started",
        "artifact_published",
        "gate_passed",
        "gate_failed",
        "eval_completed",
        "attack_completed",
        "decision_issued",
        "lesson_promoted",
        "approval_required",
        "approval_resolved",
        "workflow_finished",
        "stage_cancelled",
        "audit_completed",
        "improvement_applied",
        "agent_step",
        "debug_result"
      ],
      "title": "EventType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A single step in an inner-loop agent's *execution flow* (agent mode).\n\nWhen an external agent (Codex / Claude Code) drives the inner loop, every\ntool call it makes (and the final answer) is streamed back as one\n``AgentStepEvent`` so the run record captures *what the agent actually did* \u2014\nnot just the final metric. The frontend renders these in a collapsible\n\"Agent \u6267\u884c\u6d41\u6c34\" panel. ``seq`` orders steps within one agent turn.",
  "properties": {
    "args_summary": {
      "default": "",
      "title": "Args Summary",
      "type": "string"
    },
    "detail": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Detail"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "$ref": "#/$defs/EventType",
      "default": "agent_step"
    },
    "kind": {
      "title": "Kind",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "result_summary": {
      "default": "",
      "title": "Result Summary",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "seq": {
      "default": 0,
      "minimum": 0,
      "title": "Seq",
      "type": "integer"
    },
    "tool": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tool"
    }
  },
  "required": [
    "run_id",
    "kind"
  ],
  "title": "AgentStepEvent",
  "type": "object"
}