{
  "$defs": {
    "EventType": {
      "enum": [
        "program_created",
        "workflow_requested",
        "workflow_started",
        "stage_queued",
        "stage_started",
        "artifact_published",
        "gate_passed",
        "gate_failed",
        "eval_completed",
        "attack_completed",
        "decision_issued",
        "lesson_promoted",
        "approval_required",
        "approval_resolved",
        "workflow_finished",
        "stage_cancelled",
        "audit_completed",
        "improvement_applied",
        "agent_step",
        "debug_result"
      ],
      "title": "EventType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Recursive-improvement meta-loop committed a change to the research *process*.\n\nDistinguishes the dual loop from a single loop: the improvement targets the *mechanism*\n(routing bias / prompt hint / experience / search order), not the artifact. Carries a\nrollback id so a degrading change can be reverted (validate-and-revert).",
  "properties": {
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "$ref": "#/$defs/EventType",
      "default": "improvement_applied"
    },
    "improvement_id": {
      "title": "Improvement Id",
      "type": "string"
    },
    "metrics_after": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Metrics After",
      "type": "object"
    },
    "metrics_before": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Metrics Before",
      "type": "object"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "proposal_ref": {
      "title": "Proposal Ref",
      "type": "string"
    },
    "reverted": {
      "default": false,
      "title": "Reverted",
      "type": "boolean"
    },
    "rollback_id": {
      "title": "Rollback Id",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "target_mechanism": {
      "title": "Target Mechanism",
      "type": "string"
    },
    "validated_heldout": {
      "default": true,
      "title": "Validated Heldout",
      "type": "boolean"
    }
  },
  "required": [
    "run_id",
    "improvement_id",
    "target_mechanism",
    "proposal_ref",
    "rollback_id"
  ],
  "title": "ImprovementAppliedEvent",
  "type": "object"
}