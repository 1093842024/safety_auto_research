{
  "$defs": {
    "EventType": {
      "enum": [
        "program_created",
        "workflow_requested",
        "workflow_started",
        "stage_queued",
        "stage_started",
        "artifact_published",
        "gate_passed",
        "gate_failed",
        "eval_completed",
        "attack_completed",
        "decision_issued",
        "lesson_promoted",
        "approval_required",
        "approval_resolved",
        "workflow_finished",
        "stage_cancelled"
      ],
      "title": "EventType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A previously opened approval was resolved (approved or rejected).",
  "properties": {
    "approval_id": {
      "title": "Approval Id",
      "type": "string"
    },
    "decision_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decision Ref"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "$ref": "#/$defs/EventType",
      "default": "approval_resolved"
    },
    "note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Note"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "resolution": {
      "title": "Resolution",
      "type": "string"
    },
    "resolved_by": {
      "title": "Resolved By",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "approval_id",
    "resolution",
    "resolved_by"
  ],
  "title": "ApprovalResolvedEvent",
  "type": "object"
}